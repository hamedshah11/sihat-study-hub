# Edge function settings for the LOCAL stack during the end-to-end tests
# (`node e2e/scripts/supabase.ts up`). Not secrets: the key below only works
# with the stub in e2e/stubs/anthropic.ts, which Playwright starts on port
# 54399. host.docker.internal is how the edge runtime container reaches it.
ANTHROPIC_API_KEY=e2e-stub-key
ANTHROPIC_BASE_URL=http://host.docker.internal:54399
